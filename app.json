{
  "expo": {
    "name": "SuperHIIT",
    "slug": "superhiit",
    "scheme": "superhiit",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b0b0b",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.nexalyze.superhiit"
    },
    "android": {
      "package": "br.com.nexalyze.superhiit",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0b0b"
      },
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#0b0b0b"
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#FFE600",
          "defaultChannel": "avisos"
        }
      ]
    ]
  }
}
